# =====================================================
# SHOPEE LIVE VIEW BOT APPS - Environment Configuration
# =====================================================
# Salin file ini menjadi .env dan isi semua variabel
# yang bertanda [WAJIB] sebelum menjalankan di production.
#
# Cara generate secret:
#   Linux/Mac: openssl rand -hex 32
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
# =====================================================

# [WAJIB] Session signing secret (min 32 karakter, idealnya 64 karakter hex)
SESSION_SECRET=

# [WAJIB] Master password untuk dashboard login (min 12 karakter)
APP_MASTER_PASSWORD=

# [OPSIONAL] Bearer token untuk akses API server-to-server (tanpa login)
# API_BEARER_TOKEN=

# [OPSIONAL] Telegram Bot Notification
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# [OPSIONAL] Discord Webhook Notification
# DISCORD_WEBHOOK_URL=

# [OPSIONAL] Server configuration
NODE_ENV=production
PORT=3000
